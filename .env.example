# Copy this file to `.env` and fill in your Supabase project values.
# Find them in: Supabase Dashboard → Project Settings → API
#
# Without these values the app runs in LOCAL MODE (browser storage, single device).
# With them filled in, everything is stored in Supabase with RLS + realtime sync.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
